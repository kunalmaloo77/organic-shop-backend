# Copy this file to .env and update with your actual values

# Application
NODE_ENV=production
PORT=8080

# MongoDB Configuration
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=your_secure_mongodb_password_here
MONGO_DB_NAME=organic_shop
MONGO_URI=mongodb_uri_here

# Redis Configuration
REDIS_PASSWORD=your_secure_redis_password_here

# JWT Configuration
JWT_ACCESS_SECRET=your_secure_jwt_secret_here_min_32_chars
JWT_REFRESH_SECRET=your_secure_jwt_refresh_secret_here_min_32_chars
JWT_ACCESS_EXPIRY=xmins
JWT_REFRESH_EXPIRY=ydays

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=your_aws_region
S3_BUCKET_NAME=your_s3_bucket_name

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Razorpay Configuration
RAZOR_PAY_API_KEY=your_razorpay_key_id
RAZOR_PAY_API_SECRET=your_razorpay_key_secret
